{
    "name": "alfacode-team/hkm-plugin-school-curriculum",
    "description": "Curriculum programmes, phases, books and per-teacher plans, with auto-planning.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolCurriculum\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolCurriculum\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
